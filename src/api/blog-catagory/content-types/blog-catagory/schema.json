{
  "kind": "collectionType",
  "collectionName": "blog_catagories",
  "info": {
    "singularName": "blog-catagory",
    "pluralName": "blog-catagories",
    "displayName": "blog-catagory"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "blogs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog.blog",
      "mappedBy": "catagory"
    }
  }
}
