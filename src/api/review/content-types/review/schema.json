{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "review"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "trip": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::trip.trip",
      "inversedBy": "reviews"
    },
    "guide": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "trip_date": {
      "type": "date"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "review": {
      "type": "text"
    }
  }
}
