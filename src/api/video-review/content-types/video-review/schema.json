{
  "kind": "collectionType",
  "collectionName": "video_reviews",
  "info": {
    "singularName": "video-review",
    "pluralName": "video-reviews",
    "displayName": "Video Review"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "trip": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::trip.trip",
      "inversedBy": "video_reviews"
    },
    "reviewer_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "youtube_url": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "title": {
      "type": "string"
    },
    "display_order": {
      "type": "integer",
      "default": 0
    }
  }
}
