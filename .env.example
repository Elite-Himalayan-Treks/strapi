HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Public URLs (used for 2C2P return URLs)
PUBLIC_URL=http://localhost:1337
FRONTEND_URL=http://localhost:3000

# Booking
BOOKING_DEPOSIT_PERCENT=30

# 2C2P Payment Gateway (https://developer.2c2p.com/)
# Sandbox demo (Singapore / SGD merchant — also accepts USD/NPR in sandbox):
# https://developer.2c2p.com/docs/sandbox
# 9042 = hash mismatch → secret key does not match merchantID.
TWOC2P_ENV=sandbox
TWOC2P_MERCHANT_ID=JT01
TWOC2P_SECRET_KEY=ECC4E54DBA738857B84A7EBC6B5DC7187B8DA68750E88AB53AAA41F548D6F2D9
# Optional overrides (defaults derived from PUBLIC_URL / FRONTEND_URL)
# TWOC2P_BASE_URL=https://sandbox-pgw.2c2p.com/payment/4.3
# TWOC2P_BACKEND_RETURN_URL=http://localhost:1337/api/bookings/payment/callback
# TWOC2P_FRONTEND_RETURN_URL=http://localhost:3000/booking/payment-result
# Dev only — never enable in production
TWOC2P_ALLOW_UNVERIFIED_CALLBACK=true
